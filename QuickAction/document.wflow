					<key>COMMAND_STRING</key>
					<string>for app in "$HOME/Applications/UnzipClick.app" "/Applications/UnzipClick.app"; do
  if [ -d "$app" ]; then
    /usr/bin/open -a "$app" "$@"
    exit 0
  fi
done
echo "找不到 UnzipClick.app" &gt;&amp;2
exit 1</string>
